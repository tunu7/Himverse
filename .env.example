# Himverse.AI environment variables.
# Copy to .env.local for local development: cp .env.example .env.local
# NEVER commit real values. See docs/operations/ENVIRONMENTS.md.

# --- Public (inlined into browser bundles; must not be secret) ---------------

# Canonical URL of this deployment, used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project API URL. Local: printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (formerly "anon" key). Safe for browsers ONLY
# because Row Level Security is enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# "true" shows "Continue with Google". Enable only after the Google provider is
# configured in Supabase Auth (docs/operations/ENVIRONMENTS.md, Google sign-in).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Optional: support address shown on /privacy and /terms.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------

# Supabase secret key (formerly "service_role"). BYPASSES RLS.
# Read only via src/lib/env.server.ts, only for documented admin paths.
SUPABASE_SECRET_KEY=replace-with-secret-key

# --- AI itineraries (server only; ADR-0003) -----------------------------------

# Which AI backend plans itineraries (ADR-0003, ADR-0006). Switch with env only:
#   gateway  Vercel AI Gateway (default). Model is "provider/model".
#   ollama   Ollama. Locally: free, run `npm run ai:ollama` once first.
#            Deployed: Ollama Cloud or a self-hosted server (see OLLAMA_* below).
#   mock     Deterministic, tests only. Always refused when VERCEL_ENV=production,
#            and in any production build (next start) unless AI_ALLOW_MOCK=true
#            (set only by the E2E web server).
AI_PROVIDER=gateway
AI_ALLOW_MOCK=false

# Model to use. Leave empty for the provider's default:
#   gateway: anthropic/claude-sonnet-5.5   ollama: himverse-planner
# (himverse-planner is built by `npm run ai:ollama [-- <base-model>]`; re-run that
# with another base model such as qwen2.5:7b to switch local models.)
AI_ITINERARY_MODEL=

# AI Gateway key for local development. On Vercel, leave unset: the gateway
# authenticates with OIDC. Never prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=replace-with-ai-gateway-key

# Ollama's OpenAI-compatible endpoint. Local default below. On Vercel preview and
# production it must be remote HTTPS (e.g. https://ollama.com/v1 for Ollama Cloud),
# with OLLAMA_API_KEY and an explicit AI_ITINERARY_MODEL (e.g. gpt-oss:120b).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Ollama Cloud key (ollama.com → Settings → Keys) or your auth proxy's token.
# Not needed for local Ollama. Server only; never prefix with NEXT_PUBLIC_.
OLLAMA_API_KEY=

# Per-call model timeout in ms. Default: 45000 (gateway), 180000 (local ollama),
# 90000 (remote ollama).
AI_MODEL_TIMEOUT_MS=

# Kill switch: "false" stops all itinerary generation. No code change needed, but
# on Vercel env changes apply only to new deployments: change it, then redeploy.
AI_ITINERARY_ENABLED=true

# Platform-wide cap on model calls per day (IST) across all users (cost guard).
AI_DAILY_GENERATION_LIMIT=300
