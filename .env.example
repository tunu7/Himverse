# Himverse.AI environment variables.
# Copy to .env.local for local development: cp .env.example .env.local
# NEVER commit real values. See docs/operations/ENVIRONMENTS.md.

# --- Public (inlined into browser bundles; must not be secret) ---------------

# Canonical URL of this deployment, used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project API URL. Local: printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (formerly "anon" key). Safe for browsers ONLY
# because Row Level Security is enabled on every exposed table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# "true" shows "Continue with Google". Enable only after the Google provider is
# configured in Supabase Auth (docs/operations/ENVIRONMENTS.md, Google sign-in).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------

# Supabase secret key (formerly "service_role"). BYPASSES RLS.
# Read only via src/lib/env.server.ts, only for documented admin paths.
SUPABASE_SECRET_KEY=replace-with-secret-key

# --- AI itineraries (server only; ADR-0003) -----------------------------------

# "gateway" (Vercel AI Gateway, default) or "mock" (deterministic, tests only).
# The mock is always refused when VERCEL_ENV=production, and in any production
# build (next start) unless AI_ALLOW_MOCK=true (set only by the E2E web server).
AI_PROVIDER=gateway
AI_ALLOW_MOCK=false

# Model routed through the AI Gateway (provider/model).
AI_ITINERARY_MODEL=anthropic/claude-sonnet-5.5

# AI Gateway key for local development. On Vercel, leave unset: the gateway
# authenticates with OIDC. Never prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=replace-with-ai-gateway-key

# Kill switch: "false" stops all itinerary generation. No code change needed, but
# on Vercel env changes apply only to new deployments: change it, then redeploy.
AI_ITINERARY_ENABLED=true

# Platform-wide cap on model calls per day (IST) across all users (cost guard).
AI_DAILY_GENERATION_LIMIT=300
