{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run db:test)",
      "Bash(npm run db:types)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.local.*)",
      "Read(./.env.*.local)",
      "Read(./.env.*.local.*)",
      "Read(./.env.development*)",
      "Read(./.env.production*)",
      "Read(./.env.staging*)",
      "Read(./.env.preview*)",
      "Read(./.env.test*)",
      "Read(./.env.bak*)",
      "Read(./.envrc)",
      "Read(./**/.env)",
      "Read(./**/.env.local*)",
      "Read(./**/.env.production*)",
      "Bash(git diff --no-index:*)",
      "Bash(npx supabase status:*)",
      "Bash(supabase status:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npm exec supabase db push:*)",
      "Bash(npm exec -- supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase db reset --linked:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(npx supabase db reset --db-url:*)",
      "Bash(supabase db reset --db-url:*)",
      "Bash(npx supabase secrets:*)",
      "Bash(supabase secrets:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin main -f:*)",
      "Bash(git push origin +:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)"
    ]
  }
}
