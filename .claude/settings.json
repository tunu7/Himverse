{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run db:test)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(npx supabase status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset --linked:*)",
      "Bash(vercel deploy:*)"
    ]
  }
}
